{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "pinDigests": true,
  "packageRules": [
    {
      "matchDatasources": ["docker"],
      "matchUpdateTypes": ["digest"],
      "automerge": true
    },
    {
      "matchDatasources": ["docker"],
      "versioning": "redhat",
      "matchPackageNames": [
        "registry.access.redhat.com{/,}**"
      ]
    }
  ]
}
